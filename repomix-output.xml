export default function RenderModeDemo() {
  const [activeMode, setActiveMode] = useState<Mode>("email");

  const html = useMemo(() => {
    try {
      const { head, body } = renderToHtmlParts(<ModePreviewTemplate mode={activeMode} />, { mode: activeMode });
