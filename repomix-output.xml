            View Full Billing Portal →
          </Button>
        </Column>
      </Row>

      {/* FOOTER */}
      <Row
        style={{
          backgroundColor: palette.neutral[100],
          padding: '24px 32px',
          borderTop: `1px solid ${palette.neutral[200]}`,
        }}
      >
        <Column style={{ width: '100%' }}>
          <Html html={footerTableHtml} />
        </Column>
      </Row>
    </Email>
  );
}
