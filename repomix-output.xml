        <Column style={{ width: '40%', textAlign: 'right' }}>
          <Paragraph style={{ color: palette.neutral[300], fontSize: '9px', margin: 0 }}>
            {payload.invoiceId} — Page 1 of 1
          </Paragraph>
        </Column>
      </Row>
    </Document>
  );
}

export default InvoiceDoc;
