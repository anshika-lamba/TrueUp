  values: {},
  renderer: {
    exporters: {
      web:   (v) => \`<div>…\${v.headline} \${v.days}:\${v.hours}:\${v.minutes}…</div>\`,
      email: (v) => \`<table role="presentation">…</table>\`,
    },
    head: { css: () => ".countdown-digits { font-variant-numeric: tabular-nums; }" },
